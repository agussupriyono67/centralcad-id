---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = "Central CAD — Solusi CAD & BIM Berlisensi Resmi di Indonesia",
  description = "Central CAD menyediakan software ZWCAD 2026 dan ZW3D berlisensi permanen resmi untuk manufaktur, arsitektur, dan konstruksi di Indonesia. Kompatibel 100% DWG tanpa langganan tahunan.",
  canonical = Astro.url.href,
  ogImage = "/images/centralcad-bg.webp"
} = Astro.props;

const siteUrl = "https://centralcad.id";
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Favicon -->
    <link rel="icon" type="image/webp" href="/images/centralcad-logo.webp" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).href} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, siteUrl).href} />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-T77ZX6MD');</script>
    <!-- End Google Tag Manager -->

    <!-- Google tag (gtag.js): Google Ads AW-18087991581 + GA4 G-9F2SSNMBXP -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18087991581"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18087991581');
      gtag('config', 'G-9F2SSNMBXP');
    </script>

    <!-- Robots Meta -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="geo.region" content="ID" />
    <meta name="geo.placename" content="Indonesia" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://centralcad.id/#organization",
          "name": "Central CAD Indonesia",
          "url": "https://centralcad.id",
          "logo": "https://centralcad.id/images/centralcad-logo.webp",
          "description": "Distributor & Reseller Resmi Software ZWCAD dan ZW3D di Indonesia.",
          "telephone": "+6281912244662",
          "contactPoint": [
            {
              "@type": "ContactPoint",
              "telephone": "+62-811-1141-403",
              "contactType": "customer service",
              "areaServed": "ID",
              "availableLanguage": ["Indonesian", "English"]
            }
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://centralcad.id/#website",
          "url": "https://centralcad.id",
          "name": "Central CAD",
          "publisher": { "@id": "https://centralcad.id/#organization" }
        }
      ]
    })} />
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased selection:bg-blue-600 selection:text-white">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-T77ZX6MD"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />

    <!-- Floating WhatsApp CTA -->
    <aside aria-label="Kontak Cepat WhatsApp" class="fixed bottom-6 right-6 z-50 flex items-center gap-3">
      <a
        href="https://wa.me/6281912244662?text=Halo%20centralcad.id%20,%20aku%20mau%20informasi%20untuk%20ZWCAD%20dan%20pembelian%20lisensinya%20ya"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-3 rounded-full shadow-lg hover:shadow-emerald-600/30 hover:-translate-y-1 transition-all duration-200"
      >
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.159.57 4.184 1.564 5.938l-1.664 6.082 6.221-1.632c1.692.923 3.633 1.45 5.7 1.45 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z"/>
        </svg>
        <span class="text-sm hidden sm:inline">Chat WhatsApp</span>
      </a>
    </aside>
    <!-- Automated Google Ads & GA4 WhatsApp Conversion Tracking -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        document.addEventListener('click', function(e) {
          var link = e.target.closest('a');
          if (!link) return;
          var href = link.getAttribute('href') || '';
          if (href.indexOf('wa.me') !== -1 || href.indexOf('whatsapp.com') !== -1) {
            if (typeof gtag === 'function') {
              gtag('event', 'conversion', {
                send_to: 'AW-18087991581/sdN8CKya2IgdEJ2yg7FD',
                value: 0.0,
                currency: 'IDR',
                transport_type: 'beacon'
              });
              gtag('event', 'klik_whatsapp', {
                event_category: 'lead',
                event_label: href
              });
            }
            if (window.dataLayer) {
              window.dataLayer.push({
                event: 'whatsapp_click',
                wa_url: href
              });
            }
          }
        });
      });
    </script>
  </body>
</html>
