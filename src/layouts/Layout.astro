---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = "Central CAD — Solusi CAD & BIM Berlisensi Resmi di Indonesia",
  description = "Central CAD menyediakan software ZWCAD 2026 dan ZW3D berlisensi permanen resmi untuk manufaktur, arsitektur, dan konstruksi di Indonesia. Kompatibel 100% DWG tanpa langganan tahunan.",
  canonical = Astro.url.href,
  ogImage = "/images/centralcad-bg.webp"
} = Astro.props;

const siteUrl = "https://centralcad.id";
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-T77ZX6MD');</script>
    <!-- End Google Tag Manager -->

    <!-- Google tag (gtag.js): Google Ads AW-18087991581 + GA4 G-9F2SSNMBXP -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18087991581"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18087991581');
      gtag('config', 'G-9F2SSNMBXP');
    </script>

    <!-- Robots Meta -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="geo.region" content="ID" />
    <meta name="geo.placename" content="Indonesia" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/assets/zwsoft/icons/zwcad-logo.svg" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://centralcad.id/#organization",
          "name": "Central CAD Indonesia",
          "alternateName": "PT Hetra Teknologi Indonesia",
          "url": "https://centralcad.id",
          "logo": "https://centralcad.id/images/centralcad-logo.webp",
          "description": "Distributor & Reseller Resmi Software ZWCAD dan ZW3D di Indonesia.",
          "telephone": "+62-819-1224-4662",
          "contactPoint": [
            {
              "@type": "ContactPoint",
              "telephone": "+62-819-1224-4662",
              "contactType": "sales",
              "areaServed": "ID",
              "availableLanguage": ["Indonesian", "English"]
            }
          ],
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Plaza Summarecon Bekasi Lantai 6, Jl. Bulevar Ahmad Yani",
            "addressLocality": "Bekasi",
            "postalCode": "17142",
            "addressCountry": "ID"
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://centralcad.id/#website",
          "url": "https://centralcad.id",
          "name": "Central CAD",
          "publisher": { "@id": "https://centralcad.id/#organization" }
        }
      ]
    })} />
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased selection:bg-blue-600 selection:text-white flex flex-col min-h-screen">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-T77ZX6MD"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <slot />
  </body>
</html>
