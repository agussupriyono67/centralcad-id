---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = "Central CAD — Solusi CAD & BIM Berlisensi Resmi di Indonesia",
  description = "Central CAD menyediakan software ZWCAD 2026 dan ZW3D berlisensi permanen resmi untuk manufaktur, arsitektur, dan konstruksi di Indonesia. Kompatibel 100% DWG tanpa langganan tahunan.",
  canonical = Astro.url.href,
  ogImage = "/images/centralcad-bg.webp"
} = Astro.props;

const siteUrl = "https://centralcad.id";
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="google-site-verification" content="u-_dSv22QIluzw_ZOaA8WHy9qhuYtnSdj0Rysk_bbOE" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-T77ZX6MD');</script>
    <!-- End Google Tag Manager -->

    <!-- Google tag (gtag.js): Google Ads AW-18087991581 + GA4 G-9F2SSNMBXP -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18087991581"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18087991581');
      gtag('config', 'G-9F2SSNMBXP');
    </script>

    <!-- Robots Meta -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="geo.region" content="ID" />
    <meta name="geo.placename" content="Indonesia" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />

    <slot name="head" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/assets/zwsoft/icons/zwcad-logo.svg" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://centralcad.id/#organization",
          "name": "Central CAD Indonesia",
          "alternateName": "PT Hetra Teknologi Indonesia",
          "url": "https://centralcad.id",
          "logo": "https://centralcad.id/images/centralcad-logo.webp",
          "description": "Distributor & Reseller Resmi Software ZWCAD dan ZW3D di Indonesia.",
          "telephone": "+62-819-1224-4662",
          "contactPoint": [
            {
              "@type": "ContactPoint",
              "telephone": "+62-819-1224-4662",
              "contactType": "sales",
              "areaServed": "ID",
              "availableLanguage": ["Indonesian", "English"]
            }
          ],
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Plaza Summarecon Bekasi Lantai 6, Jl. Bulevar Ahmad Yani",
            "addressLocality": "Bekasi",
            "postalCode": "17142",
            "addressCountry": "ID"
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://centralcad.id/#website",
          "url": "https://centralcad.id",
          "name": "Central CAD",
          "publisher": { "@id": "https://centralcad.id/#organization" }
        }
      ]
    })} />
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased selection:bg-blue-600 selection:text-white flex flex-col min-h-screen">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-T77ZX6MD"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <slot />

    <!-- Floating WhatsApp Button (Bulat Logo Resmi WhatsApp) -->
    <a href="https://wa.me/6281912244662?text=Halo%20centralcad.id%20,%20aku%20mau%20informasi%20untuk%20ZWCAD%20dan%20pembelian%20lisensinya%20ya" class="floating-whatsapp" target="_blank" rel="noopener noreferrer" aria-label="Chat WhatsApp Central CAD" title="Chat WhatsApp">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" class="wa-icon" aria-hidden="true" fill="currentColor">
        <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
      </svg>
    </a>

    <!-- Automated Google Ads & GA4 WhatsApp Conversion Tracking -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        document.addEventListener('click', function(e) {
          var link = e.target.closest('a');
          if (!link) return;
          var href = link.getAttribute('href') || '';
          if (href.indexOf('wa.me') !== -1 || href.indexOf('whatsapp.com') !== -1) {
            if (typeof gtag === 'function') {
              gtag('event', 'conversion', {
                send_to: 'AW-18087991581/sdN8CKya2IgdEJ2yg7FD',
                value: 0.0,
                currency: 'IDR',
                transport_type: 'beacon'
              });
              gtag('event', 'klik_whatsapp', {
                event_category: 'lead',
                event_label: href
              });
            }
            if (window.dataLayer) {
              window.dataLayer.push({
                event: 'whatsapp_click',
                event_category: 'lead',
                event_label: href
              });
            }
          }
        });
      });
    </script>
  </body>
</html>
