---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 text-slate-400 border-t border-slate-800 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10">
      
      <!-- Brand & About -->
      <div class="lg:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <img
            src="/images/centralcad-logo.webp"
            alt="Central CAD Logo"
            class="h-10 w-auto object-contain"
          />
          <span class="text-xl font-bold tracking-tight text-white font-['Plus_Jakarta_Sans']">
            CENTRAL <span class="text-amber-400">CAD</span>
          </span>
        </div>

        <p class="text-slate-400 text-xs sm:text-sm leading-relaxed max-w-sm">
          <strong>Central CAD</strong> adalah penyedia solusi resmi software desain teknik CAD &amp; 3D CAM di Indonesia. Kami membantu industri manufaktur, konsultan rekayasa, dan konstruksi memiliki lisensi software legal permanen tanpa biaya langganan yang membebani.
        </p>

        <div class="flex items-center gap-3 text-xs text-slate-400 pt-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
          <span>Didukung oleh PT Hetra Teknologi Indonesia</span>
        </div>
      </div>

      <!-- Navigation Links -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider">Navigasi Produk</h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/" class="hover:text-white transition-colors">ZWCAD 2026 Overview</a></li>
          <li><a href="/#features" class="hover:text-white transition-colors">Fitur Unggulan 2D CAD</a></li>
          <li><a href="/zw3d" class="hover:text-white transition-colors">ZW3D All-in-One 3D CAD/CAM</a></li>
          <li><a href="/#comparison" class="hover:text-white transition-colors">Perbandingan ZWCAD vs AutoCAD</a></li>
          <li><a href="/harga" class="hover:text-white transition-colors">Daftar Harga &amp; Skema Lisensi</a></li>
          <li><a href="/free-download" class="hover:text-white transition-colors">Download Free Trial 30 Hari</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="lg:col-span-4 space-y-3">
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider">Kontak &amp; Kantor Layanan</h3>
        <ul class="space-y-2.5 text-xs text-slate-300">
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-amber-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Jakarta &amp; Sekitarnya — Layanan Demo On-Site Seluruh Wilayah Industri Indonesia</span>
          </li>
          <li class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="https://wa.me/6281912244662" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 font-semibold transition-colors">
              0819-1224-4662 (WhatsApp Official)
            </a>
          </li>
          <li class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-blue-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:sales@centralcad.id" class="hover:text-blue-400 transition-colors">
              sales@centralcad.id / agus@hetratekno.com
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="mt-12 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>&copy; {currentYear} Central CAD Indonesia — PT Hetra Teknologi Indonesia. Hak Cipta Dilindungi Undang-Undang.</p>
      <p>Seluruh merek dagang ZWCAD dan ZW3D adalah milik ZWSOFT Co., Ltd.</p>
    </div>
  </div>
</footer>
