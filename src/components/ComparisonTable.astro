---
const comparisons = [
  {
    feature: 'Model Lisensi',
    autocad: 'Sewa Tahunan Wajib (Subscription)',
    zwcad: 'Lisensi Permanen Seumur Hidup (Perpetual)',
    highlight: true
  },
  {
    feature: 'Biaya Kepemilikan (3 Tahun)',
    autocad: 'Sangat Mahal (Bayar penuh tiap tahun)',
    zwcad: 'Hemat s/d 70% (Sekali bayar jadi aset)',
    highlight: true
  },
  {
    feature: 'Format File Utama',
    autocad: 'Native .DWG & .DXF',
    zwcad: '100% Native .DWG & .DXF (Semua Versi)',
    highlight: false
  },
  {
    feature: 'Kebutuhan Spesifikasi PC',
    autocad: 'Berat (RAM min. 16GB, GPU diskrit tinggi)',
    zwcad: 'Sangat Ringan (Lancar di RAM 4GB - 8GB)',
    highlight: true
  },
  {
    feature: 'Antarmuka & Shortcut Perintah',
    autocad: 'Standar Ribbon CAD',
    zwcad: 'Identik 100% (L, C, REC, TRIM, LISP sama)',
    highlight: false
  },
  {
    feature: 'Koneksi Internet untuk Bekerja',
    autocad: 'Wajib login online berkala',
    zwcad: 'Offline 100% (Dongle USB / Softkey)',
    highlight: true
  },
  {
    feature: 'Pilihan Lisensi Jaringan (Network)',
    autocad: 'Dihapus (Hanya Named User)',
    zwcad: 'Tersedia Network Floating License (Bisa di-share)',
    highlight: true
  },
  {
    feature: 'Kebijakan Upgrade Versi',
    autocad: 'Hilang akses jika berhenti bayar',
    zwcad: 'Opsional, tidak ada denda jika tidak upgrade',
    highlight: false
  }
];
---

<section id="comparison" class="py-20 bg-slate-900 text-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="badge-tag bg-blue-500/20 text-blue-300 border border-blue-400/30 mb-3">
        PERBANDINGAN HEAD-TO-HEAD
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        ZWCAD 2026 vs AutoCAD®
      </h2>
      <p class="mt-4 text-slate-300 text-base sm:text-lg">
        Lihat bagaimana ZWCAD memberikan kemampuan setara dengan efisiensi finansial dan fleksibilitas operasional yang jauh lebih menguntungkan bisnis Anda.
      </p>
    </div>

    <!-- Comparison Table Card -->
    <div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-950/70 shadow-2xl backdrop-blur-sm">
      <table class="w-full text-left border-collapse min-w-[650px]">
        <thead>
          <tr class="border-b border-slate-800 bg-slate-900/90">
            <th class="py-5 px-6 text-sm font-bold uppercase tracking-wider text-slate-400 w-2/5">
              Fitur &amp; Skema
            </th>
            <th class="py-5 px-6 text-sm font-bold uppercase tracking-wider text-slate-400 w-3/10 text-center">
              <div class="flex items-center justify-center gap-2">
                <img src="/assets/cadindonesia/logos/Logo-Autocad.png" alt="AutoCAD" class="h-6 w-auto" />
                <span>AutoCAD®</span>
              </div>
            </th>
            <th class="py-5 px-6 text-sm font-bold uppercase tracking-wider text-amber-400 w-3/10 text-center bg-blue-900/30 border-l border-r border-blue-500/30">
              <div class="flex items-center justify-center gap-2">
                <img src="/assets/cadindonesia/logos/Logo-Zwcad.png" alt="ZWCAD" class="h-6 w-auto" />
                <span class="text-white font-extrabold">ZWCAD 2026</span>
              </div>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/80 text-sm">
          {comparisons.map((row) => (
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="py-4 px-6 font-semibold text-slate-200">
                {row.feature}
              </td>
              <td class="py-4 px-6 text-slate-400 text-center">
                {row.autocad}
              </td>
              <td class="py-4 px-6 text-center font-bold text-emerald-300 bg-blue-950/30 border-l border-r border-blue-500/20">
                <div class="inline-flex items-center gap-1.5 justify-center">
                  <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  <span>{row.zwcad}</span>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Bottom Action CTA -->
    <div class="mt-12 text-center">
      <a
        href="https://hetra.orderonline.id/centralcadid"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-accent text-base py-3 px-8 shadow-xl inline-flex items-center gap-2"
      >
        <span>Buktikan Sendiri — Coba Gratis 30 Hari</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
      <p class="text-xs text-slate-400 mt-3">
        *AutoCAD® adalah merek dagang terdaftar dari Autodesk, Inc. Perbandingan dibuat berdasarkan data publik resmi.
      </p>
    </div>

  </div>
</section>
