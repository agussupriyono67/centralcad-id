---
const industries = [
  {
    title: 'Manufaktur & Permesinan',
    desc: 'Pembuatan gambar kerja fabrikasi 2D, assembly, detail toleransi, dan integrasi mulus dengan sistem CAM pemotongan CNC.',
    image: '/assets/zwsoft/images/Manufacturing.jpg',
    tag: 'Industrial Engineering'
  },
  {
    title: 'Arsitektur, Konstruksi & Interior',
    desc: 'Denah arsitektur, tampak, potongan, detail MEP (Mekanikal Elektrikal Plumbing), dan koordinasi gambar tender proyek.',
    image: '/assets/zwsoft/images/Construction.jpg',
    tag: 'AEC Industry'
  },
  {
    title: 'Teknik Sipil & Infrastruktur',
    desc: 'Perencanaan jalan raya, jembatan, bendungan, saluran drainase, serta integrasi titik koordinat pemetaan kontur tanah.',
    image: '/assets/zwsoft/images/Civil-Engineering.jpg',
    tag: 'Civil Infrastructure'
  },
  {
    title: 'Surveying & Pemetaan Wilayah',
    desc: 'Import data titik total station / GPS geodesi, pembuatan peta kontur, dan pemodelan elevasi lahan dengan akurasi tinggi.',
    image: '/assets/zwsoft/images/Surveying.jpg',
    tag: 'GIS & Survey'
  }
];
---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="badge-tag bg-blue-50 text-blue-700 border border-blue-200 mb-3">
        SEKTOR INDUSTRI
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Dipercaya di Berbagai Sektor Industri
      </h2>
      <p class="mt-4 text-slate-600 text-base sm:text-lg">
        Dari industri manufaktur presisi tinggi hingga proyek infrastruktur nasional, ZWCAD menjadi standar keandalan kerja harian.
      </p>
    </div>

    <!-- 4 Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {industries.map((ind) => (
        <div class="cad-card overflow-hidden flex flex-col group">
          <div class="relative h-48 overflow-hidden bg-slate-100">
            <img
              src={ind.image}
              alt={ind.title}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-3 text-[11px] font-bold text-white bg-blue-600/90 px-2.5 py-1 rounded">
              {ind.tag}
            </span>
          </div>

          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
                {ind.title}
              </h3>
              <p class="text-xs text-slate-600 mt-2 leading-relaxed">
                {ind.desc}
              </p>
            </div>
            
            <div class="mt-4 pt-4 border-t border-slate-100">
              <a
                href="/free-download"
                class="text-xs font-semibold text-blue-600 hover:text-blue-800 flex items-center gap-1"
              >
                <span>Evaluasi untuk Sektor Ini</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
