---
interface Props {
  active?: string;
}

const { active = 'home' } = Astro.props;

const navItems = [
  { name: 'ZWCAD', href: '/#features', id: 'zwcad' },
  { name: 'ZW3D', href: '/zw3d', id: 'zw3d' },
  { name: 'Harga', href: '/harga', id: 'harga' },
  { name: 'Tentang', href: '/tentang-kami', id: 'tentang' },
  { name: 'Kontak', href: '/hubungi-kami', id: 'kontak' },
];
---

<header class="sticky top-0 z-40 w-full glass-nav transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 sm:gap-3 group">
        <img
          src="/images/centralcad-logo.webp"
          alt="Central CAD Logo"
          class="h-8 sm:h-9 w-auto object-contain transition-transform group-hover:scale-105"
        />
        <div class="flex flex-col">
          <span class="text-base sm:text-lg font-bold tracking-tight text-white font-['Plus_Jakarta_Sans'] leading-tight">
            CENTRAL <span class="text-amber-400">CAD</span>
          </span>
          <span class="text-[9px] text-slate-300 tracking-wider uppercase font-medium">
            Authorized Partner
          </span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="px-3 py-1.5 text-sm font-medium text-slate-200 hover:text-white hover:bg-white/10 rounded-lg transition-colors"
          >
            {item.name}
          </a>
        ))}
      </nav>

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center gap-3">
        <a
          href="https://hetra.orderonline.id/centralcadid"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-accent text-xs uppercase tracking-wider font-bold py-2 px-4 shadow-md hover:shadow-lg transition-all"
        >
          Trial Gratis
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="lg:hidden flex items-center">
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Buka Menu"
          class="text-slate-300 hover:text-white p-2 rounded-lg focus:outline-none"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden bg-slate-900/95 border-b border-white/10 px-4 pt-2 pb-6 space-y-1">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block px-3 py-2.5 rounded-lg text-base font-medium text-slate-200 hover:text-white hover:bg-white/10"
      >
        {item.name}
      </a>
    ))}
    <div class="pt-4 flex flex-col gap-2">
      <a
        href="https://hetra.orderonline.id/centralcadid" target="_blank" rel="noopener noreferrer"
        class="btn-accent text-center text-sm py-2.5 font-bold uppercase tracking-wider"
      >
        Trial Gratis
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
