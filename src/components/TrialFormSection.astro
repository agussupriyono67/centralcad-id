---
import '../styles/global.css';

interface Props {
  title?: string;
  subtitle?: string;
  product?: 'zwcad' | 'zw3d' | 'all';
}

const {
  title = "Mulai Uji Coba Gratis 30 Hari",
  subtitle = "Dapatkan akses penuh fitur ZWCAD & ZW3D langsung di komputer Anda tanpa komitmen.",
  product = 'all'
} = Astro.props;
---

<section id="contact" class="py-20 bg-slate-900 text-white relative overflow-hidden scroll-mt-20">
  <div id="trial-form-section"></div>
  <!-- Background Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Uji Coba Full Version 30 Hari
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4 font-['Plus_Jakarta_Sans']">
        {title}
      </h2>
      <p class="text-slate-400 text-base">
        {subtitle}
      </p>
    </div>

    <!-- Card Container -->
    <div class="bg-slate-800/80 backdrop-blur-md rounded-2xl border border-slate-700/80 p-6 sm:p-10 shadow-2xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <!-- Benefit Points -->
        <div class="space-y-6">
          <h3 class="text-xl font-bold text-white">Apa yang Anda Dapatkan?</h3>
          
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <strong class="text-white block text-sm">Akses Fitur 100% Lengkap</strong>
                <span class="text-xs text-slate-400">Tidak ada watermark, fitur simpan/ekspor file DWG aktif penuh.</span>
              </div>
            </li>

            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <strong class="text-white block text-sm">Dukungan Teknis Langsung</strong>
                <span class="text-xs text-slate-400">Dipandu tim engineer Central CAD untuk instalasi dan uji gambar kerja.</span>
              </div>
            </li>

            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <strong class="text-white block text-sm">Tanpa Kartu Kredit</strong>
                <span class="text-xs text-slate-400">Murni evaluasi teknis. Tidak ada tagihan otomatis setelah 30 hari.</span>
              </div>
            </li>
          </ul>

          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-700/60 text-xs text-slate-300">
            <span class="font-semibold text-white block mb-1">Butuh Demo On-Site di Pabrik / Kantor?</span>
            Tim teknis kami siap berkunjung langsung ke fasilitas Anda untuk presentasi dan pengujian live.
          </div>
        </div>

        <!-- Form / Action Area -->
        <div class="bg-slate-900/90 rounded-xl p-6 border border-slate-700/60 space-y-4">
          <div class="text-center pb-2 border-b border-slate-800">
            <span class="text-xs uppercase tracking-wider text-amber-400 font-semibold">Formulir Unduh Cepat</span>
            <h4 class="text-lg font-bold text-white mt-1">Daftar Trial ZWCAD / ZW3D</h4>
          </div>

          <div class="text-center py-4 space-y-4">
            <p class="text-xs text-slate-300 leading-relaxed">
              Klik tombol di bawah untuk mengisi formulir pendaftaran trial instan dan menerima link download installer resmi versi 64-bit terbaru:
            </p>

            <a
              href="https://hetra.orderonline.id/centralcadid"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/20 transition-all inline-flex items-center justify-center gap-2 group"
            >
              <span>Isi Form Download Trial 30 Hari</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <div class="pt-2 flex items-center justify-center gap-2 text-xs text-slate-400">
              <span>Atau chat via WhatsApp:</span>
              <a
                href="https://wa.me/6281912244662?text=Halo%20centralcad.id%20,%20aku%20mau%20informasi%20untuk%20ZWCAD%20dan%20pembelian%20lisensinya%20ya"
                target="_blank"
                rel="noopener noreferrer"
                class="text-emerald-400 font-semibold hover:underline inline-flex items-center gap-1"
              >
                <span>0819-1224-4662</span>
              </a>
            </div>

            <p class="text-[11px] text-center text-slate-400 mt-3">
              <span class="inline-flex items-center gap-1.5 justify-center">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                <span>Kerahasiaan data perusahaan Anda 100% terjaga. Kami tidak melakukan spam.</span>
              </span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
