---
---

<section id="contact" class="py-20 bg-slate-950 text-white relative overflow-hidden">
  <!-- Glow background -->
  <div class="absolute inset-0 z-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-blue-900/30 via-slate-950/80 to-slate-950"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="badge-tag bg-amber-400/20 text-amber-300 border border-amber-400/30 mb-3">
        FORMULIR PERMINTAAN RESMI
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Mulai Evaluasi atau Dapatkan Penawaran Harga Khusus
      </h2>
      <p class="mt-3 text-slate-300 text-sm sm:text-base">
        Isi formulir di bawah ini untuk mengunduh installer trial resmi ZWCAD 2026 dan menerima proposal harga resmi khusus perusahaan dari Central CAD Indonesia.
      </p>
    </div>

    <!-- Form Container -->
    <div class="bg-slate-900/90 border border-slate-700/80 rounded-2xl p-6 sm:p-10 shadow-2xl backdrop-blur-md">
      
      <!-- OrderOnline Embed Container -->
      <div class="oo-embed-form-container min-h-[300px]">
        <div class="oo-embed-form-cadindonesia-7328 text-slate-200">
          <!-- Fallback Interactive Form (works without JS / before OO loads) -->
          <form
            id="lead-form"
            class="space-y-5"
            onsubmit="handleLeadSubmit(event)"
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="fullName" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Nama Lengkap *</label>
                <input
                  type="text"
                  id="fullName"
                  name="fullName"
                  required
                  placeholder="Contoh: Budi Santoso"
                  class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-3 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                />
              </div>

              <div>
                <label for="companyName" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Nama Perusahaan / Instansi *</label>
                <input
                  type="text"
                  id="companyName"
                  name="companyName"
                  required
                  placeholder="Contoh: PT Manufaktur Mandiri"
                  class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-3 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="whatsapp" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Nomor WhatsApp Aktif *</label>
                <input
                  type="tel"
                  id="whatsapp"
                  name="whatsapp"
                  required
                  placeholder="Contoh: 081234567890"
                  class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-3 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Alamat Email Perusahaan *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="nama@perusahaan.com"
                  class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-3 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="product" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Software yang Diminati</label>
                <select
                  id="product"
                  name="product"
                  class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-3 text-white text-sm focus:outline-none focus:border-blue-500"
                >
                  <option value="ZWCAD 2026 Professional">ZWCAD 2026 Professional (2D/3D &amp; LISP)</option>
                  <option value="ZWCAD 2026 Standard">ZWCAD 2026 Standard (2D Drafting Penuh)</option>
                  <option value="ZWCAD Network Floating License">ZWCAD Network Floating License (Bisa Share Seat)</option>
                  <option value="ZW3D CAD/CAM">ZW3D All-in-One 3D CAD/CAM (Modeling &amp; CNC)</option>
                </select>
              </div>

              <div>
                <label for="seatQty" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Estimasi Jumlah Lisensi (Seat)</label>
                <select
                  id="seatQty"
                  name="seatQty"
                  class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-3 text-white text-sm focus:outline-none focus:border-blue-500"
                >
                  <option value="1 - 2 Seat">1 - 2 Seat</option>
                  <option value="3 - 5 Seat">3 - 5 Seat (Paket Tim)</option>
                  <option value="6 - 15 Seat">6 - 15 Seat (Diskon Khusus Manufaktur)</option>
                  <option value="15+ Seat">Diatas 15 Seat (Corporate / Enterprise)</option>
                </select>
              </div>
            </div>

            <div class="pt-4">
              <button
                type="submit"
                class="btn-accent w-full text-base py-4 font-bold uppercase tracking-wider text-center"
              >
                Kirim Permintaan &amp; Dapatkan Proposal Resmi
              </button>
            </div>
            
            <p class="text-[11px] text-center text-slate-400 mt-3">
              🔒 Kerahasiaan data perusahaan Anda 100% terjaga. Kami tidak melakukan spam.
            </p>
          </form>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- OrderOnline Embed Script Integration -->
<script is:inline>
  if (typeof window !== 'undefined') {
    if (!window.ooe) {
      window.ooe = function() {
        (window.ooe.q = window.ooe.q || []).push(arguments);
      };
    }
  }

  function handleLeadSubmit(e) {
    e.preventDefault();
    const form = e.target;
    const name = form.fullName.value;
    const comp = form.companyName.value;
    const wa = form.whatsapp.value;
    const email = form.email.value;
    const prod = form.product.value;
    const qty = form.seatQty.value;

    const message = `Halo Central CAD Indonesia, saya ingin meminta penawaran resmi software ZWCAD:\n\n*Nama:* ${name}\n*Perusahaan:* ${comp}\n*WhatsApp:* ${wa}\n*Email:* ${email}\n*Produk:* ${prod}\n*Jumlah Seat:* ${qty}\n\nMohon dibantu surat penawaran dan link download trial-nya. Terima kasih!`;
    const waUrl = `https://wa.me/6281912244662?text=${encodeURIComponent(message)}`;
    
    // Redirect to WhatsApp
    window.open(waUrl, '_blank');
  }
</script>
<script is:inline src="https://cdn.orderonline.id/js/embed-v8.0.2.js" async></script>
<script is:inline>
  if (typeof ooe === 'function') {
    ooe('init', '68b170d3664bbd727e059fb2', '6a50744d72c2c8772c02e435', '6a50744d72c2c8772c02e436', 'oo-embed-form-cadindonesia-7328', {
      "mode": "page",
      "action": "Kirim Permintaan Penawaran",
      "title": "Form Pemesanan & Evaluasi Resmi",
      "triggerPixel": true,
      "triggerGtm": true
    });
  }
</script>
