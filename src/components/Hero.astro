---
---

<section class="relative bg-slate-950 text-white overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-32">
  <!-- Background Image with Gradient Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/centralcad-bg.webp"
      alt="Central CAD Background"
      class="w-full h-full object-cover object-center opacity-25"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-slate-950/80 via-slate-950/90 to-slate-950"></div>
  </div>

  <!-- Decorative Glow Blobs -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-blue-600/20 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-10 right-10 w-[400px] h-[300px] bg-amber-500/10 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 text-center lg:text-left space-y-6">
        
        <!-- Release Badge -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-400/30 text-blue-300 text-xs font-semibold tracking-wide uppercase">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          ZWCAD 2026 Official Release — Lisensi Permanen
        </div>

        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.15] text-white">
          Solusi Software CAD Profesional <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-cyan-300 to-amber-300">
            Tanpa Biaya Sewa Tahunan
          </span>
        </h1>

        <!-- Subheadline -->
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Tingkatkan efisiensi engineering Anda dengan <strong>ZWCAD 2026</strong>. Antarmuka identik, 100% native DWG, perintah &amp; lisp shortcut sama, performa buka file besar 3x lebih cepat, serta <strong>hak milik lisensi seumur hidup</strong>.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a
            href="/free-download"
            class="btn-accent w-full sm:w-auto text-base text-center py-3.5 px-8"
          >
            <span>Download Trial 30 Hari</span>
            <svg class="w-5 h-5 ml-1 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
          </a>
          <a
            href="#contact"
            class="btn-primary w-full sm:w-auto text-base text-center py-3.5 px-7"
          >
            <span>Konsultasi Penawaran</span>
            <svg class="w-5 h-5 ml-1 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <!-- Trust Mini Badges -->
        <div class="pt-6 border-t border-slate-800/80 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-slate-400">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Lisensi Resmi &amp; Legalitas Terjamin</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Dukungan Teknis Lokal Indonesia</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Standar DWG/DXF 100% Kompatibel</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Showcase -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Outer Glow Border Container -->
          <div class="relative rounded-2xl p-2 bg-gradient-to-tr from-blue-600 via-cyan-400 to-amber-400 shadow-2xl">
            <div class="overflow-hidden rounded-xl bg-slate-900 border border-slate-800">
              <img
                src="/assets/cadindonesia/images/cadindonesiahero.jpg"
                alt="ZWCAD 2026 Interface Showcase"
                class="w-full h-auto object-cover transform hover:scale-105 transition-transform duration-500"
                loading="eager"
              />
            </div>
          </div>

          <!-- Floating Floating Stats Card -->
          <div class="absolute -bottom-6 -left-6 bg-slate-900/95 border border-slate-700/80 rounded-xl p-4 shadow-xl backdrop-blur-md hidden sm:flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center text-emerald-400 font-bold text-lg">
              3x
            </div>
            <div>
              <p class="text-xs font-semibold text-white">Lebih Cepat Buka File</p>
              <p class="text-[11px] text-slate-400">Multi-core rendering engine</p>
            </div>
          </div>

          <!-- Floating License Card -->
          <div class="absolute -top-6 -right-6 bg-slate-900/95 border border-slate-700/80 rounded-xl p-4 shadow-xl backdrop-blur-md hidden sm:flex items-center gap-3">
            <img
              src="/assets/cadindonesia/logos/Logo-Lisensi-Seumur-hidup.png"
              alt="Perpetual License Badge"
              class="w-9 h-9 object-contain"
            />
            <div>
              <p class="text-xs font-semibold text-white">Perpetual License</p>
              <p class="text-[11px] text-amber-400 font-medium">Beli Sekali, Pakai Selamanya</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
