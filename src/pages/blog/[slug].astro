---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = Object.values(import.meta.glob('../../content/blog/*.md', { eager: true })) as any[];
  return posts.map((post) => {
    const slug = post.file.split(/[\\/]/).pop().replace('.md', '');
    return {
      params: { slug },
      props: { post, slug }
    };
  });
}

const { post, slug } = Astro.props;
const { Content } = post;
const { title, description, pubDate, author, image, tags, keywords } = post.frontmatter;

const currentUrl = `https://centralcad.id/blog/${slug}`;
const shareWaUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(`${title} - Baca selengkapnya di: ${currentUrl}`)}`;

// Load recent other posts for sidebar
const allPosts = Object.values(import.meta.glob('../../content/blog/*.md', { eager: true })) as any[];
const recentPosts = allPosts
  .map((p) => ({
    slug: p.file.split(/[\\/]/).pop().replace('.md', ''),
    title: p.frontmatter.title,
    date: p.frontmatter.pubDate,
    image: p.frontmatter.image
  }))
  .filter((p) => p.slug !== slug)
  .slice(0, 4);
---

<Layout
  title={`${title} — Central CAD`}
  description={description}
  canonical={currentUrl}
  ogImage={image}
>
  <Navbar active="blog" />

  <!-- Breadcrumbs & Header -->
  <header class="py-12 bg-slate-900 text-white relative">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-400 mb-6">
        <a href="/" class="hover:text-white transition-colors">Beranda</a>
        <span>/</span>
        <a href="/blog" class="hover:text-white transition-colors">Blog</a>
        <span>/</span>
        <span class="text-slate-200 line-clamp-1">{title}</span>
      </nav>

      <!-- Category Tags -->
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-4">
          {tags.map((tag: string) => (
            <span class="badge-tag bg-blue-500/20 text-blue-300 border border-blue-400/30 text-xs">
              {tag}
            </span>
          ))}
        </div>
      )}

      <!-- Main Article Title -->
      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
        {title}
      </h1>

      <!-- Meta Info -->
      <div class="flex flex-wrap items-center gap-4 text-xs text-slate-400 pt-2 border-t border-slate-800">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span>{author}</span>
        </div>
        <span>•</span>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <time datetime={pubDate}>{pubDate}</time>
        </div>
      </div>

    </div>
  </header>

  <!-- Article Body & Sidebar -->
  <main class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left Column: Article Content -->
        <article class="lg:col-span-8 bg-white p-6 sm:p-10 rounded-2xl border border-slate-200 shadow-sm">
          
          <!-- Featured Image -->
          <div class="rounded-xl overflow-hidden mb-10 bg-slate-100 max-h-[420px]">
            <img
              src={image}
              alt={title}
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>

          <!-- Markdown Body -->
          <div class="prose prose-slate prose-lg max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-blue-600 prose-a:font-semibold prose-img:rounded-xl">
            <Content />
          </div>

          <!-- Bottom WhatsApp CTA Banner inside article -->
          <div class="mt-12 p-6 sm:p-8 bg-gradient-to-r from-blue-900 to-slate-900 rounded-2xl text-white flex flex-col sm:flex-row items-center justify-between gap-6">
            <div class="space-y-2 text-center sm:text-left">
              <h3 class="text-xl font-bold text-white">Konsultasi Kebutuhan CAD Perusahaan Anda</h3>
              <p class="text-xs text-slate-300">
                Dapatkan demo teknis langsung dan proposal penawaran harga lisensi resmi ZWCAD 2026.
              </p>
            </div>
            <div class="flex-shrink-0">
              <a
                href="https://wa.me/6281912244662?text=Halo%20centralcad.id%20,%20aku%20mau%20informasi%20untuk%20ZWCAD%20dan%20pembelian%20lisensinya%20ya"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-accent text-sm py-3 px-6 shadow-lg inline-flex items-center gap-2"
              >
                <span>Chat WhatsApp Resmi</span>
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771z"/>
                </svg>
              </a>
            </div>
          </div>

        </article>

        <!-- Right Column: Sidebar -->
        <aside class="lg:col-span-4 space-y-8">
          
          <!-- Sticky CTA Card -->
          <div class="cad-card p-6 bg-white border border-slate-200 rounded-2xl sticky top-28 space-y-5">
            <div class="badge-tag bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs">
              EVALUASI BEBAS BIAYA
            </div>

            <h3 class="text-lg font-bold text-slate-900 leading-snug">
              Coba ZWCAD 2026 Gratis Selama 30 Hari
            </h3>

            <p class="text-xs text-slate-600 leading-relaxed">
              Buktikan kecepatan dan kompatibilitas format DWG langsung pada proyek kerja nyata Anda tanpa batasan fitur.
            </p>

            <div class="space-y-3 pt-2">
              <a
                href="https://hetra.orderonline.id/centralcadid"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-accent w-full text-center text-xs uppercase tracking-wider font-bold py-3 block shadow-md"
              >
                Download Trial 30 Hari
              </a>

              <a
                href="https://wa.me/6281912244662?text=Halo%20centralcad.id%20,%20aku%20mau%20informasi%20untuk%20ZWCAD%20dan%20pembelian%20lisensinya%20ya"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary w-full text-center text-xs uppercase tracking-wider font-bold py-3 block"
              >
                Tanya Spesifikasi Lisensi
              </a>
            </div>

            <!-- Related Articles in Sidebar -->
            {recentPosts.length > 0 && (
              <div class="pt-6 border-t border-slate-100">
                <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-4">
                  Artikel Terkait Lainnya
                </h4>
                <div class="space-y-4">
                  {recentPosts.map((rec) => (
                    <div class="flex items-center gap-3 group">
                      <img
                        src={rec.image}
                        alt={rec.title}
                        class="w-16 h-12 rounded-lg object-cover flex-shrink-0 bg-slate-100"
                        loading="lazy"
                      />
                      <div>
                        <a
                          href={`/blog/${rec.slug}`}
                          class="text-xs font-semibold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-2 leading-snug"
                        >
                          {rec.title}
                        </a>
                        <span class="text-[10px] text-slate-400">{rec.date}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

          </div>

        </aside>

      </div>
    </div>
  </main>

  <Footer />

  <!-- Schema.org Article Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": title,
    "description": description,
    "image": new URL(image, "https://centralcad.id").href,
    "datePublished": pubDate,
    "dateModified": pubDate,
    "author": {
      "@type": "Organization",
      "name": "Central CAD Indonesia",
      "url": "https://centralcad.id"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Central CAD Indonesia",
      "logo": {
        "@type": "ImageObject",
        "url": "https://centralcad.id/images/centralcad-logo.webp"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": currentUrl
    }
  })} />
</Layout>
