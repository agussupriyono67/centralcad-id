---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

// Load all markdown articles eagerly
const rawPosts = Object.values(import.meta.glob('../../content/blog/*.md', { eager: true })) as any[];

const posts = rawPosts.map((post) => {
  const slug = post.file.split(/[\\/]/).pop().replace('.md', '');
  return {
    slug,
    frontmatter: post.frontmatter
  };
}).sort((a, b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime());
---

<Layout
  title="Blog & Panduan CAD/CAM Indonesia — Central CAD"
  description="Kumpulan artikel teknis, tips drafting, benchmark performa ZWCAD 2026, panduan lisensi permanen, dan solusi perancangan manufaktur ZW3D di Indonesia."
>
  <Navbar active="blog" />

  <main class="bg-slate-50 min-h-screen">
    <!-- Header Banner -->
    <section class="py-16 bg-slate-900 text-white text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-900/40 via-slate-900 to-slate-950"></div>
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-4">
        <span class="badge-tag bg-blue-500/20 text-blue-300 border border-blue-400/30">
          KNOWLEDGE BASE &amp; TIPS CAD/CAM
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          Artikel &amp; Panduan Teknis ZWCAD
        </h1>
        <p class="text-slate-300 text-base max-w-2xl mx-auto">
          Wawasan terkini seputar optimasi efisiensi drafting, perbandingan biaya lisensi permanen, dan solusi rekayasa manufaktur terpadu.
        </p>
      </div>
    </section>

    <!-- Articles Grid Section -->
    <section class="py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <article class="cad-card flex flex-col justify-between overflow-hidden group bg-white border border-slate-200 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300">
              <div>
                <!-- Featured Image -->
                <div class="relative h-48 overflow-hidden bg-slate-100">
                  <img
                    src={post.frontmatter.image}
                    alt={post.frontmatter.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                  {post.frontmatter.tags && post.frontmatter.tags[0] && (
                    <span class="absolute top-3 left-3 bg-blue-600/90 text-white text-[11px] font-bold px-2.5 py-1 rounded">
                      {post.frontmatter.tags[0]}
                    </span>
                  )}
                </div>

                <!-- Content Info -->
                <div class="p-6">
                  <div class="flex items-center gap-2 text-xs text-slate-500 mb-3">
                    <time datetime={post.frontmatter.pubDate}>{post.frontmatter.pubDate}</time>
                    <span>•</span>
                    <span>{post.frontmatter.author}</span>
                  </div>

                  <h2 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors leading-snug mb-3">
                    <a href={`/blog/${post.slug}`}>
                      {post.frontmatter.title}
                    </a>
                  </h2>

                  <p class="text-xs text-slate-600 leading-relaxed line-clamp-3">
                    {post.frontmatter.description}
                  </p>
                </div>
              </div>

              <!-- Action Link -->
              <div class="p-6 pt-0 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-blue-600 group-hover:text-blue-700">
                <a href={`/blog/${post.slug}`} class="inline-flex items-center gap-1">
                  <span>Baca Selengkapnya</span>
                  <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>
