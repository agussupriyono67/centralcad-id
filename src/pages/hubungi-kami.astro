---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import TrialFormSection from '../components/TrialFormSection.astro';
---

<Layout
  title="Hubungi Kami — Central CAD Indonesia (Reseller Resmi ZWCAD)"
  description="Kontak resmi Central CAD Indonesia dan PT Hetra Teknologi Indonesia. Konsultasi pemilihan lisensi ZWCAD & ZW3D, jadwal demo teknis on-site di pabrik, dan permohonan quotation harga resmi."
>
  <Navbar active="contact" />

  <main>
    <!-- Header -->
    <section class="py-16 md:py-20 bg-slate-900 text-white text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-blue-900/20 to-slate-900 pointer-events-none"></div>
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-4">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-500/20 text-blue-300 border border-blue-400/30">
          <svg class="w-3.5 h-3.5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          PUSAT LAYANAN &amp; KONSULTASI RESMI
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          Hubungi Tim Central CAD Indonesia
        </h1>
        <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
          Kami siap melayani konsultasi pemilihan lisensi, jadwal demo teknis online / on-site di kantor Anda, serta penerbitan penawaran harga resmi ZWCAD &amp; ZW3D.
        </p>
      </div>
    </section>

    <!-- Contact Cards Grid -->
    <section class="py-16 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-16">
          
          <!-- Card 1: WhatsApp -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-sm flex flex-col items-center text-center hover:shadow-md transition-shadow">
            <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-5">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            </div>
            <h2 class="text-lg font-bold text-slate-900 mb-1">WhatsApp Fast Response</h2>
            <p class="text-xs text-slate-500 mb-5 leading-relaxed">Respon cepat langsung dari tim sales &amp; technical engineer kami.</p>
            <a
              href="https://wa.me/6281912244662?text=Halo%20Central%20CAD%20Indonesia,%20saya%20ingin%20konsultasi%20lisensi%20ZWCAD%20dan%20minta%20penawaran%20harga%20resmi"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-sm transition-colors text-center inline-flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
              <span>0819-1224-4662 (Chat)</span>
            </a>
          </div>

          <!-- Card 2: Email -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-sm flex flex-col items-center text-center hover:shadow-md transition-shadow">
            <div class="w-14 h-14 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center mb-5">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h2 class="text-lg font-bold text-slate-900 mb-1">Email Resmi Penawaran</h2>
            <p class="text-xs text-slate-500 mb-5 leading-relaxed">Kirimkan spesifikasi kebutuhan procurement dan tender perusahaan Anda.</p>
            <a
              href="mailto:sales@centralcad.id"
              class="w-full py-2.5 px-4 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-sm transition-colors text-center inline-flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>sales@centralcad.id</span>
            </a>
          </div>

          <!-- Card 3: Kantor & On-Site -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-sm flex flex-col items-center text-center hover:shadow-md transition-shadow">
            <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center mb-5">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <h2 class="text-lg font-bold text-slate-900 mb-1">Kantor &amp; Demo On-Site</h2>
            <p class="text-xs text-slate-500 mb-5 leading-relaxed">PT Hetra Teknologi Indonesia (Partner CAD Solution).</p>
            <div class="w-full py-2 px-3 rounded-xl bg-slate-100 text-slate-700 text-xs font-semibold text-center">
              Layanan Seluruh Kawasan Industri
            </div>
          </div>

        </div>

        <!-- Detail Kantor & Afiliasi CAD Solution -->
        <div class="max-w-5xl mx-auto bg-white rounded-2xl p-8 sm:p-10 border border-slate-200/80 shadow-sm space-y-8">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
            
            <div class="space-y-4">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
                LOKASI KANTOR RESMI
              </span>
              <h3 class="text-xl sm:text-2xl font-bold text-slate-900">
                PT Hetra Teknologi Indonesia
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed">
                Authorized Partner ZWSOFT dan pengelola jaringan portal <a href="https://cadsolution.co.id" target="_blank" rel="noopener noreferrer" class="text-blue-600 font-semibold underline hover:text-blue-700">CAD Solution (cadsolution.co.id)</a> &amp; Central CAD (<a href="https://centralcad.id" class="text-blue-600 font-semibold underline hover:text-blue-700">centralcad.id</a>).
              </p>
              
              <div class="space-y-2.5 text-xs sm:text-sm text-slate-600 pt-2">
                <div class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span><strong>Alamat:</strong> Plaza Summarecon Bekasi Lantai 6, Jl. Bulevar Ahmad Yani, Kota Bekasi, Jawa Barat 17142</span>
                </div>
                <div class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 text-blue-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span><strong>Jam Kerja:</strong> Senin – Jumat, 08:30 – 17:00 WIB</span>
                </div>
                <div class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 text-blue-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <span><strong>Email Alternatif:</strong> agus@hetratekno.com</span>
                </div>
              </div>
            </div>

            <!-- Cakupan Kunjungan On-Site -->
            <div class="p-6 rounded-xl bg-slate-50 border border-slate-200 space-y-4">
              <h4 class="text-sm font-bold text-slate-900 uppercase tracking-wider">
                Jadwalkan Kunjungan Tim Engineer
              </h4>
              <p class="text-xs text-slate-600 leading-relaxed">
                Kami siap hadir langsung di pabrik atau kantor engineering Anda untuk:
              </p>
              <ul class="text-xs text-slate-600 space-y-2">
                <li class="flex items-start gap-2">
                  <svg class="w-4 h-4 text-emerald-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Demo uji coba membuka file .DWG ratusan MB milik perusahaan Anda secara real-time.</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg class="w-4 h-4 text-emerald-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Instalasi &amp; konfigurasi Network License (Floating) di server lokal kantor Anda.</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg class="w-4 h-4 text-emerald-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Simulasi perbandingan efisiensi biaya TCO (Total Cost of Ownership) 3 tahun vs AutoCAD.</span>
                </li>
              </ul>
              <div class="pt-2">
                <a
                  href="https://wa.me/6281912244662?text=Halo%20Central%20CAD,%20saya%20ingin%20jadwalkan%20demo%20teknis%20on-site%20di%20kantor%20kami"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-xs font-bold text-blue-600 hover:text-blue-800"
                >
                  <span>Jadwalkan via WhatsApp Sekarang</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- Form Section -->
    <TrialFormSection />
  </main>

  <Footer />
</Layout>
