---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import TrialFormSection from '../components/TrialFormSection.astro';

const tiers = [
  {
    name: 'ZWCAD 2026 Standard',
    desc: 'Solusi terbaik untuk drafter yang fokus pada pembuatan gambar kerja 2D, denah, potongan, dan cetak plotting.',
    badge: 'Drafting 2D Murni',
    highlight: false,
    features: [
      'Lisensi Permanen Seumur Hidup (Perpetual)',
      '100% Native Kompatibel DWG/DXF',
      'Antarmuka Classic & Ribbon AutoCAD Style',
      'Fitur Cerdas: Smart Mouse & Smart Select',
      'Smart Plotting Batch Printing',
      'Pilihan Lisensi Standalone (Softkey / USB Dongle)',
      'Dukungan Teknis Resmi Indonesia'
    ],
    ctaText: 'Minta Penawaran Standard'
  },
  {
    name: 'ZWCAD 2026 Professional',
    desc: 'Edisi terlengkap dan paling banyak digunakan di Indonesia untuk engineering, arsitektur, dan manufaktur.',
    badge: 'Paling Populer',
    highlight: true,
    features: [
      'Semua Kemampuan Versi Standard',
      'Pemodelan 3D Solid & Surface Modeling',
      'Dukungan Penuh AutoLISP, VBA, .NET, dan ZRX',
      'Fitur Cerdas: Smart Voice & Similar Search',
      'Point Cloud & IFC Underlay Import',
      'Kemampuan Render Realistis & DGN Underlay',
      'Pilihan Standalone atau Network Floating',
      'Dukungan Teknis Prioritas'
    ],
    ctaText: 'Minta Penawaran Professional'
  },
  {
    name: 'ZWCAD Network Floating',
    desc: 'Solusi lisensi terpusat di server kantor yang bisa dipakai bergantian secara fleksibel oleh puluhan drafter.',
    badge: 'Optimal untuk Tim & Korporasi',
    highlight: false,
    features: [
      'Semua Kemampuan Versi Professional',
      'Server License Manager Terpusat (LAN/VPN)',
      '1 Lisensi Bisa Dipakai Bergantian Antar-Drafter',
      'Fitur Borrow License (Bisa Dipakai Tanpa Internet)',
      'Monitoring Pemakaian Lisensi Real-time',
      'Efisiensi Anggaran untuk Tim Skala Menengah-Besar',
      'Dukungan Setup & Konfigurasi Server Gratis'
    ],
    ctaText: 'Konsultasi Network License'
  }
];
---

<Layout
  title="Daftar Harga & Skema Lisensi ZWCAD 2026 — Central CAD Indonesia"
  description="Daftar pilihan paket lisensi resmi software ZWCAD 2026 dan ZW3D di Indonesia. Lisensi seumur hidup permanen tanpa beban sewa tahunan."
>
  <Navbar active="harga" />

  <main>
    <!-- Header -->
    <section class="py-16 bg-slate-900 text-white text-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
        <span class="badge-tag bg-blue-500/20 text-blue-300 border border-blue-400/30">
          INVESTASI CERDAS SEKALI BAYAR
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          Pilihan Paket &amp; Lisensi ZWCAD 2026
        </h1>
        <p class="text-slate-300 text-base max-w-2xl mx-auto">
          Miliki lisensi software CAD berlisensi sah hukum dengan harga resmi distributor. Dilengkapi faktur pajak, sertifikat keaslian, dan dukungan teknis lokal.
        </p>
      </div>
    </section>

    <!-- Pricing Grid -->
    <section class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
          {tiers.map((tier) => (
            <div class={`rounded-2xl p-8 flex flex-col justify-between transition-all duration-300 ${tier.highlight ? 'bg-slate-900 text-white ring-2 ring-blue-500 shadow-2xl scale-105 z-10' : 'bg-white text-slate-900 border border-slate-200 shadow-sm hover:shadow-md'}`}>
              <div>
                <span class={`inline-block text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-4 ${tier.highlight ? 'bg-amber-400 text-slate-950' : 'bg-blue-100 text-blue-800'}`}>
                  {tier.badge}
                </span>

                <h2 class={`text-2xl font-bold tracking-tight mb-2 ${tier.highlight ? 'text-white' : 'text-slate-900'}`}>
                  {tier.name}
                </h2>

                <p class={`text-sm mb-6 ${tier.highlight ? 'text-slate-300' : 'text-slate-600'}`}>
                  {tier.desc}
                </p>

                <div class="border-t border-slate-200/20 pt-6">
                  <h3 class={`text-xs font-bold uppercase tracking-wider mb-4 ${tier.highlight ? 'text-blue-300' : 'text-slate-500'}`}>
                    Fitur &amp; Keuntungan:
                  </h3>
                  <ul class="space-y-3 text-sm">
                    {tier.features.map((feat) => (
                      <li class="flex items-start gap-2.5">
                        <svg class={`w-5 h-5 flex-shrink-0 mt-0.5 ${tier.highlight ? 'text-emerald-400' : 'text-emerald-600'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span class={tier.highlight ? 'text-slate-200' : 'text-slate-700'}>{feat}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="pt-8 mt-8 border-t border-slate-200/20">
                <a
                  href="#contact"
                  class={`w-full text-center py-3.5 px-6 rounded-xl font-bold text-sm block transition-all ${tier.highlight ? 'btn-accent shadow-lg' : 'btn-primary'}`}
                >
                  {tier.ctaText}
                </a>
              </div>
            </div>
          ))}
        </div>

        <!-- Dongle vs Softkey Info Box -->
        <div class="mt-16 bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <div class="flex items-center gap-2 mb-2 text-blue-700 font-bold text-base">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
              </svg>
              <span>Aktivasi Softkey (Digital License)</span>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              Kode lisensi digital yang diaktifkan langsung di laptop/PC. Pengiriman kode instan, aktivasi via internet atau offline return, dan mudah dikelola tanpa risiko kehilangan fisik barang.
            </p>
          </div>

          <div>
            <div class="flex items-center gap-2 mb-2 text-emerald-700 font-bold text-base">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
              </svg>
              <span>Aktivasi Hardware Dongle (USB Key)</span>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              Kunci lisensi berbasis USB flash drive fisik. Sangat fleksibel dipindahkan ke laptop kantor, PC rumah, atau komputer lapangan tanpa perlu koneksi internet sama sekali. Cukup tancap dan jalankan ZWCAD.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- Trial & Order Form Section -->
    <TrialFormSection />
  </main>

  <Footer />
</Layout>
