---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import TrialFormSection from '../components/TrialFormSection.astro';

const waUrl = "https://wa.me/6281912244662?text=Halo%20centralcad.id%20,%20aku%20mau%20informasi%20untuk%20ZWCAD%20dan%20pembelian%20lisensinya%20ya";
---

<Layout
  title="Daftar Harga & Skema Lisensi Resmi ZWCAD 2026 — Central CAD Indonesia"
  description="Daftar harga resmi lisensi permanen software ZWCAD 2026 (Standard, Professional, MFG) di Indonesia. Lisensi seumur hidup tanpa beban sewa tahunan, hemat biaya hingga 70%."
>
  <Navbar active="harga" />

  <main>
    <!-- Header Hero -->
    <section class="py-16 bg-slate-900 text-white text-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-500/20 text-blue-300 border border-blue-400/30">
          INVESTASI CERDAS SEKALI BAYAR • LISENSI PERMANEN RESMI
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight font-['Plus_Jakarta_Sans']">
          Daftar Harga Lisensi ZWCAD 2026
        </h1>
        <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
          Tentukan paket lisensi CAD terbaik sesuai kebutuhan industri Anda. Didukung lisensi seumur hidup (perpetual), garansi resmi keaslian software, faktur pajak PPN 11%, dan tim dukungan teknis lokal di Indonesia.
        </p>
      </div>
    </section>

    <!-- SECTION PRICELIST (Identik dengan Halaman Depan Central CAD) -->
    <section class="py-20 bg-slate-50" id="pricelist">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-14">
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-['Plus_Jakarta_Sans']">
            Tentukan Kebutuhan Anda!
          </h2>
          <p class="text-slate-600 text-base mt-2">
            Lisensi seumur hidup, update lisensi dikenakan biaya 35% dari harga
          </p>
        </div>

        <div class="pricing-grid">
          <!-- Card 1: ZWCAD Standard -->
          <article class="pricing-card">
            <div class="pricing-card-header">
              <div class="pricing-brand">
                <img decoding="async" src="/assets_zwsoft/icons/zwcad-logo.svg" alt="ZWCAD" class="pricing-logo" />
                <span class="pricing-edition">Standard</span>
              </div>
              <p class="pricing-desc">Pilihan hemat untuk membuat gambar 2D CAD</p>
            </div>

            <div class="pricing-prices">
              <div class="price-tier">
                <span class="tier-label">Standalone</span>
                <span class="tier-amount">IDR 15.300.000</span>
              </div>
              <div class="price-tier">
                <span class="tier-label">Network</span>
                <span class="tier-amount">IDR 17.030.000</span>
              </div>
            </div>

            <div class="pricing-divider"></div>

            <ul class="pricing-features">
              <li>
                <svg class="price-check-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <circle cx="10" cy="10" r="10" fill="#E8F8F0"/>
                  <path d="M6 10.5L8.5 13L14 7.5" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Native DWG compatibility</span>
              </li>
              <li>
                <svg class="price-check-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <circle cx="10" cy="10" r="10" fill="#E8F8F0"/>
                  <path d="M6 10.5L8.5 13L14 7.5" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>2D drafting tools</span>
              </li>
              <li>
                <svg class="price-check-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <circle cx="10" cy="10" r="10" fill="#E8F8F0"/>
                  <path d="M6 10.5L8.5 13L14 7.5" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>LISP routines</span>
              </li>
            </ul>

            <div class="pricing-cta-wrap">
              <a class="pricing-btn" href={waUrl} target="_blank" rel="noopener noreferrer">
                Beli sekarang
              </a>
            </div>
          </article>

          <!-- Card 2: ZWCAD Professional (Paling Populer) -->
          <article class="pricing-card pricing-card-featured">
            <div class="pricing-badge-popular">PALING POPULER</div>

            <div class="pricing-card-header">
              <div class="pricing-brand">
                <img decoding="async" src="/assets_zwsoft/icons/zwcad-logo.svg" alt="ZWCAD" class="pricing-logo" />
                <span class="pricing-edition">Professional</span>
              </div>
              <p class="pricing-desc">Pilihan tepat untuk membuat gambar 2D dan 3D modeling</p>
            </div>

            <div class="pricing-prices">
              <div class="price-tier">
                <span class="tier-label">Standalone</span>
                <span class="tier-amount">IDR 23.800.000</span>
              </div>
              <div class="price-tier">
                <span class="tier-label">Network</span>
                <span class="tier-amount">IDR 26.400.000</span>
              </div>
            </div>

            <div class="pricing-divider"></div>

            <ul class="pricing-features">
              <li>
                <svg class="price-check-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <circle cx="10" cy="10" r="10" fill="#E8F8F0"/>
                  <path d="M6 10.5L8.5 13L14 7.5" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Semua fitur standard</span>
              </li>
              <li>
                <svg class="price-check-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
