                <td class="py-3.5 px-5 text-center text-emerald-700 font-semibold">Seumur Hidup (Perpetual)</td>
                <td class="py-3.5 px-5 text-center text-emerald-700 font-semibold bg-blue-50/30">Seumur Hidup (Perpetual)</td>
                <td class="py-3.5 px-5 text-center text-emerald-700 font-semibold">Seumur Hidup (Perpetual)</td>
              </tr>
