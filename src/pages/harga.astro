                <span class="pricing-edition">MFG</span>
              </div>
              <p class="pricing-desc">2D/3D CAD profesional dengan toolset mekanikal</p>
            </div>

            <div class="pricing-prices">
              <div class="price-tier">
                <span class="tier-label">Standalone</span>
