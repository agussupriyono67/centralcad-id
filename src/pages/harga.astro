    <!-- Digital License Information Box (Kebijakan Zero Dongle Fisik) -->
    <section class="py-12 bg-slate-50 border-t border-slate-200">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <div class="flex items-center gap-2 mb-3 text-blue-700 font-bold text-base">
              <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
              </svg>
              <span>Aktivasi Softkey Digital (Single User Standalone)</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Kode lisensi digital resmi (24-digit Key Number) yang diaktifkan langsung pada komputer atau laptop drafter. Lisensi dapat ditransfer atau dipindahkan ke komputer baru sewaktu-waktu secara mandiri tanpa biaya tambahan.
            </p>
          </div>

          <div>
            <div class="flex items-center gap-2 mb-3 text-emerald-700 font-bold text-base">
