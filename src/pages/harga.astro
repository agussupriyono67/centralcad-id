              </li>
              <li>
                <svg class="price-check-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <circle cx="10" cy="10" r="10" fill="#E8F8F0"/>
                  <path d="M6 10.5L8.5 13L14 7.5" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Mechanical calculation tools</span>
              </li>
            </ul>

            <div class="pricing-cta-wrap">
              <a class="pricing-btn" href={waUrl} target="_blank" rel="noopener noreferrer">
                Beli sekarang
              </a>
            </div>
          </article>
        </div>

        <div class="pricing-notes">
          <p>• Harga belum termasuk pajak 11%</p>
          <p>• Lisensi akan terbit 2–14 hari (Normalnya 2 hari)</p>
        </div>

      </div>
    </section>

    <!-- TABEL PERBANDINGAN HARGA & SPESIFIKASI LISENSI -->
    <section class="py-16 bg-white border-t border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-10">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 mb-3">
