---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const WA = "https://wa.me/6281912244662?text=Halo%20centralcad.id%20,%20aku%20mau%20informasi%20ZW3D%20dan%20pembelian%20lisensinya%20ya";
const TRIAL = "https://hetra.orderonline.id/centralcadid";

type Item = { title: string; tip?: string[]; rows?: string[] };
type Tab = { key: string; label: string; name: string; syn: string; video: string; items: Item[] };

const tabs: Tab[] = [
  {
    key: 'part',
    label: 'Part Design',
    name: 'Bangun Part Kompleks dengan Kendali dan Kecepatan',
    syn: 'Dengan Hybrid Modeling, kapabilitas part design ZW3D memungkinkan Anda membuat dan memodifikasi part kompleks secara presisi dan cepat, diperkuat modul profesional untuk kebutuhan desain lanjutan.',
    video: '/assets/zw3d-ov/video/Video1.mp4',
    items: [
      {
        title: 'Pemodelan profesional dan akurat untuk part design',
        tip: [
          'Kapabilitas pemodelan tangguh yang digerakkan oleh 3D Geometric Modeling Overdrive™ Kernel.',
          'Kombinasi parametric dan direct modeling — ideal untuk desain detail berbasis aturan maupun perubahan cepat yang intuitif.',
        ],
        rows: [
          '• Parametric Modeling — Buat dan modifikasi model kompleks berdasarkan relasi serta constraint yang telah ditetapkan.',
          '• Direct Editing — Lakukan perubahan cepat dan tepat sasaran tanpa terikat constraint parametrik.',
          '• Surface Modeling — Ciptakan permukaan halus dengan presisi, didukung beragam metode pembuatan dan editing surface.',
        ],
      },
      {
        title: 'Modul khusus untuk skenario lanjutan',
        rows: ['• Advanced Tools — Sheet metal, structural design, serta modul khusus seperti Harness, kolaborasi ECAD/MCAD, dan Piping.'],
      },
      {
        title: 'Buat dan kelola variasi desain dengan mudah',
        rows: ['• Design Configuration — Kelola beberapa variasi desain dalam satu file dengan mengatur dimensi, fitur, dan parameter.'],
      },
      {
        title: 'Komunikasikan desain kompleks secara sederhana',
        rows: ['• Web-Based Viewing — Ekspor ke HTML untuk berbagi cepat dan akses model detail langsung di browser standar.'],
      },
    ],
  },
  {
    key: 'assembly',
    label: 'Assembly Design',
    name: 'Jaga Assembly Mesin Besar Tetap Responsif',
    syn: 'ZW3D memungkinkan pengelolaan assembly kompleks dengan mudah lewat tools cerdas yang mempercepat desain, memastikan integrasi presisi, dan memperjelas komunikasi melalui animasi intuitif.',
    video: '/assets/zw3d-ov/video/Video2.mp4',
    items: [
      {
        title: 'Performa sangat lancar untuk assembly kompleks',
        tip: ['Arsitektur data assembly yang efisien menjaga rotasi, section, dan editing tetap responsif bahkan pada ribuan komponen.'],
        rows: [
          '• Large Assembly Support — Tangani assembly hingga 20.000 komponen dengan alur kerja yang didukung penuh.',
          '• Lightweight Mode — Muat assembly besar lebih cepat dengan representasi ringan tanpa kehilangan referensi.',
        ],
      },
      {
        title: 'Tools cerdas untuk mempercepat desain assembly',
        rows: [
          '• Smart Constraints — Deteksi otomatis relasi antar komponen untuk perakitan lebih cepat.',
          '• Assembly Clone — Duplikasi assembly utuh dengan penyesuaian komponen minor secara instan.',
        ],
      },
      {
        title: 'Menjaga akurasi assembly',
        rows: ['• Interference Check — Deteksi benturan dan toleransi antar komponen sebelum masuk produksi.'],
      },
      {
        title: 'Menyajikan konsep assembly secara jelas',
        rows: ['• Exploded View & Animation — Buat presentasi perakitan dan instruksi kerja yang mudah dipahami tim produksi.'],
      },
    ],
  },
  {
    key: 'drawing',
    label: '2D Drawing',
    name: 'Buat Gambar Produksi yang Selalu Selaras',
    syn: 'ZW3D menyederhanakan pembuatan gambar 2D dengan mengotomatiskan tugas berulang. Pembuatan gambar yang cepat dan terhubung asosiatif ke model 3D menghasilkan output akurat dan konsisten.',
    video: '/assets/zw3d-ov/video/Video3.mp4',
    items: [
      {
        title: 'Update asosiatif antara model 3D dan gambar 2D',
        tip: ['Setiap perubahan pada model 3D langsung memperbarui view, dimensi, dan anotasi terkait tanpa intervensi manual.'],
        rows: ['• Associative Drawing — Gambar 2D selalu mengikuti geometri terbaru dari model 3D.'],
      },
      {
        title: 'Pembuatan gambar 2D intuitif dan otomatis',
        rows: [
          '• Auto Dimensioning — Penempatan dimensi otomatis mengikuti standar drafting yang Anda tetapkan.',
          '• Smart Balloon & BOM — Nomor part dan bill of materials terhubung langsung ke struktur assembly.',
        ],
      },
      {
        title: 'Generasi drawing view berperforma tinggi',
        rows: ['• Fast View Generation — Potongan, detail, dan proyeksi dibuat dalam hitungan detik, bahkan untuk model kompleks.'],
      },
    ],
  },
  {
    key: 'cae',
    label: 'Simulation (CAE)',
    name: 'Validasi Keputusan Sebelum Logam Dipotong',
    syn: 'Solusi desain-simulasi terintegrasi untuk desain yang optimal dan keputusan engineering berbasis data.',
    video: '/assets/zw3d-ov/video/Video4.mp4',
    items: [
      {
        title: 'Sempurnakan desain lebih awal dengan insight akurat',
        tip: ['Analisis struktural di lingkungan desain memungkinkan iterasi cepat sebelum biaya tooling dan material dikeluarkan.'],
        rows: ['• Early Validation — Deteksi area kritis sejak tahap konsep, bukan setelah prototipe fisik dibuat.'],
      },
      {
        title: 'Tools simulasi profesional untuk skenario spesifik',
        rows: [
          '• Structural Analysis — Analisis tegangan, deformasi, dan faktor keamanan komponen mesin.',
          '• Modal & Thermal — Evaluasi getaran alami serta distribusi suhu pada part dan assembly.',
        ],
      },
      {
        title: 'Kompatibel dengan model legacy dan standar industri',
        rows: ['• Legacy Model Support — Validasi model hasil impor dari CAD lain tanpa perlu rekonstruksi.'],
      },
      {
        title: 'Data akurat dan multi-physics coupling lanjutan',
        rows: ['• Multi-Physics — Kombinasikan beban struktural, termal, dan dinamik dalam satu studi terpadu.'],
      },
    ],
  },
  {
    key: 'cam',
    label: 'Manufacturing (CAM)',
    name: 'Ubah Geometri Rilis Menjadi Toolpath Andal',
    syn: 'Alur kerja desain ke manufaktur yang mulus untuk produksi yang efisien dan konsisten.',
    video: '/assets/zw3d-ov/video/Video5.mp4',
    items: [
      {
        title: 'Produksi berkualitas dengan strategi machining menyeluruh',
        tip: ['Strategi roughing hingga finishing 2–5 axis tersedia langsung di lingkungan ZW3D tanpa perpindahan software.'],
        rows: [
          '• 2–5 Axis Machining — Dukung kebutuhan milling, drilling, dan contouring untuk part mesin presisi.',
          '• High-Speed Machining — Optimasi jalur pahat untuk waktu siklus lebih pendek dan usia tool lebih panjang.',
        ],
      },
      {
        title: 'Kolaborasi desain-ke-manufaktur yang mulus',
        rows: ['• Associative CAM — Toolpath ikut memperbarui otomatis saat geometri desain berubah.'],
      },
      {
        title: 'Akurasi machining terbukti dengan simulasi lanjutan',
        rows: ['• Machine Simulation — Verifikasi toolpath, holder, dan fixture di ruang virtual sebelum eksekusi di lantai produksi.'],
      },
    ],
  },
  {
    key: 'pdm',
    label: 'Collaboration (PDM)',
    name: 'Kendalikan Rekaman Engineering di Dalam ZW3D',
    syn: 'Manajemen data produk yang ringkas, memungkinkan desain kolaboratif, kendali data, dan rilis dokumen langsung di dalam platform ZW3D.',
    video: '/assets/zw3d-ov/video/Video6.mp4',
    items: [
      {
        title: 'Dorong produktivitas R&D dengan desain kolaboratif',
        rows: [
          '• Fully Embedded in ZW3D — Selesaikan desain produk, kolaborasi tim, dan rilis data langsung di antarmuka 3D yang familiar.',
          '• Shared Workspace — Folder bersama dengan struktur berjenjang memastikan seluruh tim mengakses file dan data yang sama.',
          '• Component Reuse in Assembly — Integrasikan subassembly atau part hasil rancangan anggota tim, dengan update asosiatif yang menjaga konsistensi desain.',
        ],
      },
      {
        title: 'Optimalkan kendali proses untuk meningkatkan kualitas produk',
        rows: [
          '• Design Iteration Control — Berpindah antar tahap dan nilai progres desain untuk pengambilan keputusan lebih cepat.',
          '• Threaded Comments and Reviews — Umpan balik terorganisir dengan riwayat diskusi yang terdokumentasi.',
          '• Trackable Approval History — Setiap langkah approval tercatat: pengaju, tahap, approver, waktu, dan catatan.',
        ],
      },
      {
        title: 'Pastikan keamanan data melalui manajemen data terpadu',
        rows: [
          '• Precise Access Control — Hak akses fleksibel berdasarkan status proyek dan peran tim.',
          '• Version Management — Otomasi upgrade versi minor via check-in/check-out, dengan kendali otorisasi pada rilis mayor.',
          '• Real-Time Data Sync — Perubahan model ditandai seketika, memastikan akses selalu ke versi terbaru.',
        ],
      },
    ],
  },
];

const faqs = [
  { q: 'Apa itu ZW3D?', a: 'ZW3D adalah software rekayasa 3D profesional yang dirancang untuk produsen mesin dan machine builder. ZW3D menyatukan kapabilitas CAD, CAE, dan CAM untuk desain, validasi, dan persiapan manufaktur dalam satu alur kerja yang terhubung.' },
  { q: 'Untuk apa ZW3D digunakan?', a: 'ZW3D mendukung pekerjaan engineering mesin sehari-hari: part design, assembly kompleks, gambar produksi 2D, simulasi, persiapan machining, dan kolaborasi engineering. ZW3D juga membantu tim mengelola perubahan desain serta menggunakan ulang data engineering lintas proyek.' },
  { q: 'Apakah ZW3D cocok untuk desain mesin?', a: 'Ya. Alur kerja engineering ZW3D dibangun dengan pendekatan produsen mesin, machine builder, dan tim mechanical engineering sebagai acuan utama.' },
  { q: 'Apakah ZW3D sudah mencakup CAD, CAE, dan CAM?', a: 'Ya. ZW3D menyediakan kapabilitas CAD, CAE, dan CAM dalam satu lingkungan engineering terhubung, sehingga tim dapat bergerak dari desain mekanikal dan validasi menuju persiapan manufaktur dengan lebih sedikit perpindahan tools.' },
  { q: 'Bisakah ZW3D membuka file dari software CAD lain?', a: 'ZW3D mendukung lebih dari 25 format impor dan ekspor untuk pertukaran serta penggunaan ulang data engineering lintas lingkungan CAD yang berbeda.' },
  { q: 'Apakah ZW3D mampu menangani assembly besar?', a: 'ZW3D memiliki kapabilitas large-assembly untuk alur kerja mesin yang menuntut, termasuk alur kerja yang didukung untuk assembly hingga 20.000 komponen.' },
  { q: 'Apa itu ZW3D WuKong?', a: 'ZW3D WuKong adalah generasi baru ZW3D yang dibangun di atas arsitektur parametrik baru. Dirancang untuk meningkatkan regenerasi model, asosiativitas, dan performa pada alur kerja engineering berat seperti desain mesin kompleks dan assembly besar.' },
  { q: 'Bisakah saya mencoba ZW3D secara gratis?', a: 'Ya. ZW3D tersedia dengan trial gratis 30 hari berfitur penuh melalui PT Hetra Teknologi Indonesia, sehingga Anda dapat mengevaluasi kapabilitas desain, validasi, dan manufakturnya langsung pada alur kerja Anda sendiri.' },
];

const stories = [
  { stat: '65%', label: 'biaya software lebih rendah', desc: 'Desain 40% lebih cepat', company: 'NEXT Robotics', meta: 'MACHINERY · THAILAND', img: '/assets/zw3d-ov/data1.png' },
  { stat: '40-50%', label: 'efisiensi desain lebih tinggi', desc: 'Hemat renewal ≈ RM50K per tahun', company: 'APEX', meta: 'STEEL PRODUCTS · MALAYSIA', img: '/assets/zw3d-ov/data2.png' },
  { stat: '20%', label: 'waktu desain terpangkas', desc: 'Putaran konsep lebih cepat', company: 'Cyrus', meta: 'MACHINERY · INDIA', img: '/assets/zw3d-ov/data3.png' },
  { stat: '2 minggu → 3 hari', label: 'siklus prototipe', desc: 'Review gambar 40% lebih singkat', company: 'Engetak', meta: 'AUTOMOTIVE · BRAZIL', img: '/assets/zw3d-ov/data4.jpg' },
];

const reviews = [
  { name: 'Ssasb A.', role: 'Mechanical Engineering CAD', text: 'ZW3D menyatukan CAD dan CAM dalam satu platform, membuat desain dan manufaktur jauh lebih efisien.', star: 5 },
  { name: 'Zulfadhli H.', role: 'Technical Manager', text: 'ZW3D menawarkan file translator yang tangguh, menangani berbagai format secara efisien dan membantu kolaborasi lintas platform.', star: 4.5 },
  { name: 'Andri S.', role: 'Machine Design Engineer', text: 'Transisi dari CAD sebelumnya berjalan mulus. Model lama tetap terbaca, dan tim langsung produktif tanpa pelatihan panjang.', star: 4.5 },
];
---

<Layout
  title="ZW3D CAD/CAM Indonesia — Software 3D Engineering untuk Desain Mesin, Mold & CNC"
  description="ZW3D: software 3D CAD/CAE/CAM terintegrasi untuk produsen mesin dan manufaktur presisi di Indonesia. Hybrid Modeling, assembly besar, drawing asosiatif, simulasi, dan CAM 2-5 axis dalam satu platform. Lisensi permanen resmi PT Hetra Teknologi Indonesia."
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/assets/zw3d-ov/page.css" />
    <link rel="stylesheet" href="/assets/zw3d-ov/extra.css" />
  </Fragment>

  <Navbar active="zw3d" />

  <!-- ================= ZW3D PRODUCT PAGE (mirror zwsoft.com/product/zw3d) ================= -->
  <div class="ov-page zw3d-mirror">

    <!-- hero start -->
    <div class="ov-heromain" style="position: relative;">
      <div class="ov-herobg pc_show" style="background-image: url('/assets/zw3d-ov/banner.jpg');"></div>
      <div class="ov-herobg mobile_show" style="background-image: url('/assets/zw3d-ov/mobile_banner.png');"></div>
      <div class="ov-herotext">
        <div class="ov-herobox">
          <span class="ov-kicker d-bold">INTEGRATED CAD · CAE · CAM · PDM</span>
          <h1 class="ov-herotitles d-bold">Rekayasa Terhubung.<br />Dibangun untuk <span class="ov-hl d-bold">Mesin.</span></h1>
          <p class="ov-herotextbox">
            Bergerak dari konsep mesin menuju produksi di ZW3D — desain, validasi, manufaktur, dan data engineering bekerja dalam satu lingkungan yang terhubung.
          </p>
          <div class="ov-herobuttom">
            <a class="zw-button big d-bold" href={TRIAL} target="_blank" rel="noopener noreferrer">Mulai Trial Gratis 30 Hari</a>
            <a class="zw-button big d-bold blue" href="/harga">Lihat Harga</a>
          </div>
        </div>
      </div>
      <div class="ov-hero-video-bpx">
        <div class="ov-hero-video">
          <div class="play-box is-video" data-mp4="https://www.youtube.com/embed/OpZgyAEMmZI?rel=0" style="position: static;">
            <div class="video-play da-play"></div>
          </div>
        </div>
      </div>
    </div>
    <!-- hero end -->

    <!-- why start -->
    <section class="ov-sec ov-why">
      <div class="ov-wrap">
        <div class="ov-sec-head">
          <span class="ov-kicker d-bold">MENGAPA ZW3D</span>
          <div class="ov-title-box">
            <h2 class="ov-title d-bold">Satu lingkungan<br />engineering.<br />Empat keunggulan bisnis.</h2>
            <p class="ov-desc">Tim mesin membutuhkan lebih dari sekadar tools modeling yang terisolasi. ZW3D menghubungkan keputusan, deliverable, dan know-how yang mengubah niat engineering menjadi pekerjaan siap produksi.</p>
          </div>
        </div>
        <div class="ov-why-grid">
          <div class="ov-card">
            <div>
              <div class="ov-card-ico"><img src="/assets/zw3d-ov/icon-why1.svg" alt="" loading="lazy" /></div>
              <h3 class="d-bold">Rancang Mesin Lebih Cepat</h3>
              <p>Dari konsep hingga mesin utuh dengan tools part, assembly, drawing, validasi, dan manufaktur kelas profesional.</p>
            </div>
            <a class="ov-link d-bold" href="#capabilities">Lihat keunggulan <img class="a_icon" src="/assets/zw3d-ov/arrow-right-blue.svg" alt="" width="14" loading="lazy" /></a>
          </div>
          <div class="ov-card">
            <div>
              <div class="ov-card-ico"><img src="/assets/zw3d-ov/icon-why2.svg" alt="" loading="lazy" /></div>
              <h3 class="d-bold">Hubungkan Desain ke Produksi</h3>
              <p>Gambar kerja, simulasi, CAM, dan data produk tetap selaras saat desain terus berubah.</p>
            </div>
            <a class="ov-link d-bold" href="#connect">Lihat keunggulan <img class="a_icon" src="/assets/zw3d-ov/arrow-right-blue.svg" alt="" width="14" loading="lazy" /></a>
          </div>
          <div class="ov-card">
            <div>
              <div class="ov-card-ico"><img src="/assets/zw3d-ov/icon-why3.svg" alt="" loading="lazy" /></div>
              <h3 class="d-bold">Pertahankan Pengetahuan Engineering</h3>
              <p>Gunakan ulang model, metode, standar, dan pengalaman tim alih-alih membangun kembali pekerjaan yang sudah terbukti.</p>
            </div>
            <a class="ov-link d-bold" href="#work">Lihat keunggulan <img class="a_icon" src="/assets/zw3d-ov/arrow-right-blue.svg" alt="" width="14" loading="lazy" /></a>
          </div>
          <div class="ov-card">
            <div>
              <div class="ov-card-ico"><img src="/assets/zw3d-ov/icon-why4.svg" alt="" loading="lazy" /></div>
              <h3 class="d-bold">Kendali Penuh</h3>
              <p>Pilih skema lisensi, deployment, hardware, dan jalur adopsi yang sesuai dengan operasional Anda.</p>
            </div>
            <a class="ov-link d-bold" href="#terms">Lihat keunggulan <img class="a_icon" src="/assets/zw3d-ov/arrow-right-blue.svg" alt="" width="14" loading="lazy" /></a>
          </div>
        </div>
      </div>
    </section>
    <!-- why end -->

    <!-- workflow tabs start -->
    <section class="ov-sec ov-tabs" id="capabilities">
      <div class="ov-wrap">
        <div class="ov-sec-head">
          <span class="ov-kicker d-bold">KAPABILITAS</span>
          <h2 class="ov-title d-bold">Tools Profesional di Seluruh Alur Kerja Engineering Mesin</h2>
          <p class="ov-desc">Dari part dan assembly hingga drawing, simulasi, CAM, dan kendali data produk — semuanya bekerja dalam satu platform yang terhubung.</p>
        </div>

        <div class="dd-main">
          <div class="dd-swiperbox">
            <div class="dd-swiper">
              <div class="swiper-container dds-b">
                <div class="swiper-wrapper">
                  {tabs.map((t, i) => (
                    <div class={`swiper-slide dds-item${i === 0 ? ' active' : ''}`} data-tab={t.key}>
                      <div class="dds-link">
                        <div class="dds-name d-bold">{t.label}</div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          {tabs.map((t, i) => (
            <div class={`dd-one${i === 0 ? ' show' : ''}`} data-pane={t.key}>
              <div class="dd-top">
                <div class="dd-name d-bold">{t.name}</div>
                <div class="dd-synopsis">{t.syn}</div>
              </div>
              <div class="dd-bottom">
                <div class="dd-right">
                  <div class="dd-imgbox">
                    <div class="dd-img play-box is-video" data-mp4={t.video}>
                      <video video_src={t.video} muted loop playsinline preload="none" src={t.video}></video>
                    </div>
                  </div>
                </div>
                <div class="dd-left">
                  {t.items.map((it) => (
                    <div class="dd-nav">
                      <div class="dd-buttom">
                        <div class="dd-classify d-bold">
                          {it.title}
                          {it.tip && (
                            <div class="dd-query">
                              <div class="ddq-icon"><img src="/assets/zw3d-ov/warning-circle.svg" alt="" loading="lazy" /></div>
                              <div class="ddq-sub">
                                <div class="ddq-box">
                                  <div class="ddq-textbox">
                                    {it.tip.map((p) => <p>{p}</p>)}
                                  </div>
                                </div>
                              </div>
                            </div>
                          )}
                        </div>
                      </div>
                      {it.rows && (
                        <div class="dd-sub">
                          <div class="dd-tr">
                            {it.rows.map((r) => {
                              const idx = r.indexOf(' — ');
                              return (
                                <div class="dd-td">
                                  {idx > 0 ? (
                                    <><span class="d-bold">{r.slice(0, idx)}</span> — {r.slice(idx + 3)}</>
                                  ) : r}
                                </div>
                              );
                            })}
                          </div>
                        </div>
                      )}
                      <div class="dd-line"></div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <!-- workflow tabs end -->

    <!-- dark platform start -->
    <section class="ov-sec ov-dark" id="connect">
      <div class="ov-wrap">
        <div class="ov-dark-flex">
          <div class="ov-dark-left">
            <img src="/assets/zw3d-ov/cax-platform-diagram.svg" alt="Diagram platform CAx terpadu ZW3D" loading="lazy" />
          </div>
          <div class="ov-dark-right">
            <span class="ov-kicker d-bold">TERHUBUNG SEJAK DESAIN</span>
            <h2 class="ov-title d-bold">Hubungkan Desain ke Produksi</h2>
            <p class="ov-desc">Perubahan desain seharusnya mendorong pekerjaan engineering maju — bukan memicu pencarian manual di setiap deliverable hilir.</p>
            <ul class="ov-dark-list">
              <li class="ov-dark-item">
                <img src="/assets/zw3d-ov/icon-dark5.svg" alt="" loading="lazy" />
                <div>
                  <p class="ov-dark-title d-bold">Asosiatif secara bawaan</p>
                  <p class="ov-desc-desc">Perbarui drawing, referensi assembly, dan pekerjaan CAM dari desain yang sedang berkembang.</p>
                </div>
              </li>
              <li class="ov-dark-item">
                <img src="/assets/zw3d-ov/icon-dark6.svg" alt="" loading="lazy" />
                <div>
                  <p class="ov-dark-title d-bold">Kurangi risiko serah terima</p>
                  <p class="ov-desc-desc">Pastikan tim selalu bekerja dari geometri terkini, data tervalidasi, dan rilis yang terkendali.</p>
                </div>
              </li>
              <li class="ov-dark-item">
                <img src="/assets/zw3d-ov/icon-dark7.svg" alt="" loading="lazy" />
                <div>
                  <p class="ov-dark-title d-bold">Lindungi waktu produksi</p>
                  <p class="ov-desc-desc">Deteksi dampak perubahan lebih awal dan hilangkan pekerjaan persiapan berulang akibat file yang terputus.</p>
                </div>
              </li>
            </ul>
            <div class="ov-dark-bottom">
              <div class="ov-dark-bottom-item">
                <img src="/assets/zw3d-ov/icon-dark8.svg" alt="" loading="lazy" />
                <div>
