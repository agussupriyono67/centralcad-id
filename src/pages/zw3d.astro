<style is:inline>
  /* ===== Netralkan gaya global situs agar visual identik dengan halaman sumber ===== */
  .zw3d-mirror { font-family: notosansregular, "Noto Sans", "Helvetica", "Arial", sans-serif; }
  .zw3d-mirror p { font-family: notosansregular, "Noto Sans", "Helvetica", "Arial", sans-serif; }
  .zw3d-mirror .ov-sec-head { max-width: 100%; }
  .zw3d-mirror ul { list-style: none; margin: 0; padding: 0; }
  .zw3d-mirror h1, .zw3d-mirror h2, .zw3d-mirror h3 { letter-spacing: normal; }
  .zw3d-mirror a { text-decoration: none; }

  /* Carousel pengganti Swiper: horizontal scroll-snap (tanpa dependensi) */
  .zw3d-mirror .ov-data-swiper { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .zw3d-mirror .ov-data-swiper::-webkit-scrollbar { display: none; }
  .zw3d-mirror .ov-data-swiper .swiper-wrapper { display: flex; flex-wrap: nowrap; width: auto !important; height: auto !important; }
  .zw3d-mirror .ov-data-swiper .swiper-slide { flex: 0 0 33.3333%; width: 33.3333% !important; height: auto !important; scroll-snap-align: start; }

  .zw3d-mirror .dk-b { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .zw3d-mirror .dk-b::-webkit-scrollbar { display: none; }
  .zw3d-mirror .dk-b .swiper-wrapper { display: flex; flex-wrap: nowrap; width: auto !important; height: auto !important; transform: none !important; }
  .zw3d-mirror .dk-b .dk-item { flex: 0 0 33.333%; width: 33.333% !important; height: auto !important; scroll-snap-align: start; }

  .zw3d-mirror .dds-b { overflow-x: auto; scrollbar-width: none; }
  .zw3d-mirror .dds-b::-webkit-scrollbar { display: none; }
  .zw3d-mirror .dds-b .swiper-wrapper { display: flex; flex-wrap: nowrap; width: auto !important; height: auto !important; }
  .zw3d-mirror .dds-item { flex-shrink: 0; }

  @media (max-width: 1200px) {
    .zw3d-mirror .dk-b .dk-item { flex: 0 0 50%; width: 50% !important; }
    .zw3d-mirror .ov-data-swiper .swiper-slide { flex: 0 0 50%; width: 50% !important; }
  }
  @media (max-width: 992px) {
    .zw3d-mirror .dk-b .dk-item { flex: 0 0 100%; width: 100% !important; }
    .zw3d-mirror .ov-data-swiper .swiper-slide { flex: 0 0 86%; width: 86% !important; }
    .zw3d-mirror .dds-item { min-width: 200px; }
  }

  /* Tab & accordion state */
  .zw3d-mirror .dd-one { display: none; }
  .zw3d-mirror .dd-one.show { display: block; }
  .zw3d-mirror .ov-acc-body { display: none; }
  .zw3d-mirror .ov-acc-item.open .ov-acc-body { display: block; }
  .zw3d-mirror .ov-acc-item.open .ov-acc-ico { transform: rotate(180deg); }
  .zw3d-mirror .ov-acc-ico { transition: transform .25s ease; }
  .zw3d-mirror .ov-acc-item { cursor: pointer; }

  /* Video player overlay */
  .zw3d-video-modal {
    position: fixed; inset: 0; z-index: 9999; display: none;
    align-items: center; justify-content: center;
    background: rgba(0, 0, 0, 0.9); padding: 4vw;
  }
  .zw3d-video-modal.show { display: flex; }
  .zw3d-video-modal .inner { position: relative; width: 100%; max-width: 1100px; }
  .zw3d-video-modal video,
  .zw3d-video-modal iframe { width: 100%; aspect-ratio: 16/9; border: 0; border-radius: 12px; display: block; background: #000; }
  .zw3d-video-modal .close-btn {
    position: absolute; top: -46px; right: 0; width: 40px; height: 40px;
    border: 0; border-radius: 50%; background: rgba(255,255,255,.12); color: #fff;
    font-size: 22px; line-height: 1; cursor: pointer;
  }
</style>

<script is:inline>
  (function () {
    var ROOT_SEL = '.zw3d-mirror';

    function init() {
      var root = document.querySelector(ROOT_SEL);
      if (!root) return;

      /* ---- Capability tabs ---- */
      var tabBtns = root.querySelectorAll('.dds-item');
      var panes = root.querySelectorAll('.dd-one');
      tabBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var key = btn.getAttribute('data-tab');
          tabBtns.forEach(function (b) { b.classList.remove('active'); });
          btn.classList.add('active');
          panes.forEach(function (p) {
            p.classList.toggle('show', p.getAttribute('data-pane') === key);
          });
          if (window.innerWidth < 992) {
            var pane = root.querySelector('.dd-one.show');
            if (pane) {
              var y = pane.getBoundingClientRect().top + window.pageYOffset - 90;
              window.scrollTo({ top: y, behavior: 'smooth' });
            }
          }
        });
      });

      /* ---- Tooltip (dd-query) ---- */
      root.querySelectorAll('.dd-query').forEach(function (q) {
        q.addEventListener('mouseenter', function () { q.classList.add('show'); });
        q.addEventListener('mouseleave', function () { q.classList.remove('show'); });
        q.addEventListener('click', function (e) { e.stopPropagation(); q.classList.toggle('show'); });
      });

      /* ---- FAQ accordion ---- */
      root.querySelectorAll('.ov-acc-item').forEach(function (item) {
        item.querySelector('.ov-acc-head').addEventListener('click', function () {
          var isOpen = item.classList.contains('open');
          root.querySelectorAll('.ov-acc-item').forEach(function (i) {
            i.classList.remove('open');
            var b = i.querySelector('.ov-acc-body'); if (b) b.style.display = '';
          });
          if (!isOpen) {
            item.classList.add('open');
            var body = item.querySelector('.ov-acc-body'); if (body) body.style.display = 'block';
          }
        });
      });

      /* ---- Video modal ---- */
      var modal = document.createElement('div');
      modal.className = 'zw3d-video-modal';
      modal.innerHTML = '<div class="inner"><button class="close-btn" aria-label="Tutup">&times;</button><div class="slot"></div></div>';
      document.body.appendChild(modal);
      var slot = modal.querySelector('.slot');
      function closeModal() {
        modal.classList.remove('show');
        slot.innerHTML = '';
        document.body.style.overflow = '';
      }
      modal.querySelector('.close-btn').addEventListener('click', closeModal);
      modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });

      root.querySelectorAll('.play-box').forEach(function (box) {
        box.addEventListener('click', function () {
          var src = box.getAttribute('data-mp4') || '';
          if (!src) return;
          if (src.indexOf('youtube') !== -1) {
            slot.innerHTML = '<iframe src="' + src + '&autoplay=1" allow="autoplay; encrypted-media; fullscreen" allowfullscreen></iframe>';
          } else {
            slot.innerHTML = '<video src="' + src + '" controls autoplay playsinline></video>';
          }
          modal.classList.add('show');
          document.body.style.overflow = 'hidden';
        });
      });

      /* ---- Autoplay video di tab aktif (muted loop) ---- */
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            var v = en.target.querySelector('video');
            if (!v) return;
            if (en.isIntersecting) { v.play().catch(function () {}); } else { v.pause(); }
          });
        }, { threshold: 0.35 });
        root.querySelectorAll('.dd-img').forEach(function (el) { io.observe(el); });
      }
    }

    /* ---- Carousel: delegasi klik, tanpa dependensi Swiper ---- */
    document.addEventListener('click', function (e) {
      var next = e.target.closest && e.target.closest('[data-carousel-next]');
      var prev = e.target.closest && e.target.closest('[data-carousel-prev]');
      if (!next && !prev) return;
      var key = next ? next.getAttribute('data-carousel-next') : prev.getAttribute('data-carousel-prev');
      var el = document.querySelector('.zw3d-mirror [data-carousel="' + key + '"]');
      if (!el) return;
      var step = el.clientWidth;
      var slide = el.querySelector('.swiper-slide, .dk-item');
      if (slide) step = slide.getBoundingClientRect().width * (key === 'dk' ? 1 : 1);
      var dir = next ? 1 : -1;
      el.scrollTo(el.scrollLeft + dir * step, 0);
      setTimeout(function () {
        var prevBtn = document.querySelector('.zw3d-mirror [data-carousel-prev="' + key + '"]');
        var nextBtn = document.querySelector('.zw3d-mirror [data-carousel-next="' + key + '"]');
        var atStart = el.scrollLeft <= 2;
        var atEnd = el.scrollLeft + el.clientWidth >= el.scrollWidth - 2;
        if (prevBtn) prevBtn.classList.toggle('disabled', atStart);
        if (nextBtn) nextBtn.classList.toggle('disabled', atEnd);
      }, 350);
    }, true);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
